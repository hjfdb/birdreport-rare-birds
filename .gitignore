# 依赖
node_modules/

# 构建产物（node build-exe.mjs 生成）
build/
dist/

# 运行时缓存（会自动重建）
data/

# 本地工作日志
.workbuddy/

# 杂项
*.log
shots/
.DS_Store
# 排查用的临时夹具（探针脚本、日志、下载物…）。只匹配仓库根目录，别误伤子目录里的正常文件
/tmp-*

# ---- Android ----
# Gradle 构建产物
android/.gradle/
android/build/
android/app/build/
# CMake 的构建缓存（编译 native-lib.cpp 时生成，几百 KB 到几 MB，且与机器相关）
android/app/.cxx/
# 机器相关：本机 Android SDK 位置
android/local.properties
# 签名密钥：**随私有库提交**（android/keystore.properties + android/keystore/birdreport.jks），
# 本地与 CI 共用同一把钥匙。仓库若转为公开，先把这两个文件从历史里清掉、并换一把新钥匙
# （见 README「关于签名」）。其它位置散落的密钥文件仍然忽略，防止误提交。
android/*.keystore
android/*.jks
android/**/*.jks
!android/keystore/**
# nodejs-mobile 预编译运行时：解包后约 190 MB，用 android/fetch-nodejs-mobile.mjs 按需拉取
android/third_party/
