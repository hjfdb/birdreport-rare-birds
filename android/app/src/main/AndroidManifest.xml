<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 服务端要在手机上直接访问 api.birdreport.cn，需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 「稀有监听」发现新的稀有鸟种时发系统通知。
         Android 13（API 33）起这是**运行时**权限：清单里声明只是前提，
         真正授权要等用户点掉系统对话框 —— 页面在开启监听时会通过 JS 桥
         （window.BirdAndroid.requestNotify）主动申请一次，见 AndroidBridge。
         13 以前这条声明会被系统忽略（安装即得，用户可在系统设置里关）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <!--
          明文 HTTP 的口子**只通过 networkSecurityConfig 开**（只放 127.0.0.1 / localhost）。
          这里刻意**不写** android:usesCleartextTraffic="true"：那个开关是「一刀切放开」，
          写上会让整个 App 对所有域名都能走明文，也让人看不出下面那份配置到底起没起作用。
          minSdk 是 24，networkSecurityConfig 一定生效（API 24+ 它优先于 usesCleartextTraffic）。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
