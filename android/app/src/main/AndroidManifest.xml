<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 服务端要在手机上直接访问 api.birdreport.cn，需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 「稀有监听」发现新的稀有鸟种时发系统通知。
         Android 13（API 33）起这是**运行时**权限：清单里声明只是前提，
         真正授权要等用户点掉系统对话框 —— 页面在开启监听时会通过 JS 桥
         （window.BirdAndroid.requestNotify）主动申请一次，见 AndroidBridge。
         13 以前这条声明会被系统忽略（安装即得，用户可在系统设置里关）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新：服务端把新版 APK 下到应用私有目录后，交给系统安装器去装。
         Android 8（API 26）起这是个**普通**权限（安装时即得），但还要用户在系统里
         允许「安装未知应用」才会真的弹安装界面 —— 系统会自己引导，页面里也有提示。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <!--
          明文 HTTP 的口子**只通过 networkSecurityConfig 开**（只放 127.0.0.1 / localhost）。
          这里刻意**不写** android:usesCleartextTraffic="true"：那个开关是「一刀切放开」，
          写上会让整个 App 对所有域名都能走明文，也让人看不出下面那份配置到底起没起作用。
          minSdk 是 24，networkSecurityConfig 一定生效（API 24+ 它优先于 usesCleartextTraffic）。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Splash"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 应用内更新用：把「应用私有目录里下好的 APK」以只读内容 URI 交给系统安装器。
             自己写的极简 ContentProvider（不引 AndroidX，见 ApkFileProvider 的类注释）。
             exported=false + grantUriPermissions=true 是标准组合：
             不对外暴露，但可以通过 Intent 的 FLAG_GRANT_READ_URI_PERMISSION 临时授权给安装器。 -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.birdreport.hot.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
